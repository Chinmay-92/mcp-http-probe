{
  "name": "mcp-http-probe",
  "version": "0.1.0",
  "description": "Conformance probe for MCP servers speaking the Streamable HTTP transport (spec 2025-11-25).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mcp-http-probe": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "conformance",
    "streamable-http",
    "testing"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "express": "^5.1.0",
    "typescript": "^5.9.2",
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chinmay-92/mcp-http-probe.git"
  },
  "homepage": "https://github.com/Chinmay-92/mcp-http-probe#readme",
  "bugs": {
    "url": "https://github.com/Chinmay-92/mcp-http-probe/issues"
  },
  "author": "Chinmay Pingale"
}
